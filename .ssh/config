# Use IdentityAgent from 1Password
Host *
    ServerAliveInterval 60
    ForwardAgent yes
    StrictHostKeyChecking no
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# SSH over Session Manager
host i-* mi-*
  ProxyCommand sh -c "aws ssm start-session --target %h --document-name AWS-StartSSHSession --parameters 'portNumber=%p'"

Host git.developers.burberry.com
  User git
  IdentityFile ~/.ssh/aleksandr_stasko.pub
  IdentitiesOnly yes

Host gitlab-personal.com
  HostName gitlab.com
  User git
  IdentityFile ~/.ssh/AlexStasko.pub
  IdentitiesOnly yes

Host github.com
  User git
  IdentityFile ~/.ssh/AlexStasko.pub
  IdentitiesOnly yes

Host gitlab.com
  HostName gitlab.com
  User git
  IdentityFile ~/.ssh/aleksandr_stasko.pub
  IdentitiesOnly yes
